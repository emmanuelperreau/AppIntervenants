{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.js",
    "config.js",
    "agence-init.js",
    "globals.d.ts"
  ],
  "exclude": [
    "src/**/*.test.js",
    "src/**/*.ts",
    "sw.js",
    "vitest.config.js",
    "node_modules"
  ]
}
